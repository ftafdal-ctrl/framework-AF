#!/bin/bash
# ==============================================================================
# Git Pre-Commit Hook: Local Deterministic Quality Gate
# Menegakkan kepatuhan: Gitleaks (No Secrets), PHP Lint, dan PHPStan
# ==============================================================================

echo "🔍 [1/3] Memeriksa kebocoran rahasia & kredensial dengan Gitleaks..."
if command -v gitleaks &> /dev/null; then
    gitleaks protect --staged --verbose --redact
    if [ $? -ne 0 ]; then
        echo "❌ [GAGAL] Ditemukan potensi kebocoran rahasia/kunci API di berkas staged!"
        echo "Tolong hapus rahasia tersebut dan gunakan .env sebelum melakukan commit."
        exit 1
    fi
else
    echo "⚠️  Gitleaks tidak terpasang secara lokal. Pastikan CI/CD memindai rahasia."
fi

echo "🔍 [2/3] Memeriksa sintaks PHP (PHP Syntax Linting)..."
STAGED_PHP_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.php$')

if [ -n "$STAGED_PHP_FILES" ]; then
    for FILE in $STAGED_PHP_FILES; do
        if [ -f "$FILE" ]; then
            php -l "$FILE" > /dev/null
            if [ $? -ne 0 ]; then
                echo "❌ [GAGAL] Syntax error terdeteksi pada berkas: $FILE"
                exit 1
            fi
        fi
    done
    echo "✅ Seluruh berkas PHP lulus pemeriksaan sintaks."
fi

echo "🔍 [3/3] Memeriksa static analysis dengan PHPStan..."
if [ -f "vendor/bin/phpstan" ]; then
    vendor/bin/phpstan analyse -l 6 app/
    if [ $? -ne 0 ]; then
        echo "❌ [GAGAL] PHPStan menemukan potensi bug atau pelanggaran tipe data!"
        exit 1
    fi
else
    echo "ℹ️  vendor/bin/phpstan belum tersedia (jalankan composer install)."
fi

echo "🎉 Seluruh gerbang kualitas pre-commit lulus! Melanjutkan commit..."
exit 0
